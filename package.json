{
  "name": "tomori-phase1-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "node-pg-migrate up --migrations-dir db/migrations --migration-file-language sql",
    "db:down": "node-pg-migrate down --migrations-dir db/migrations --migration-file-language sql"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.2",
    "eslint": "^9.27.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.5.3",
    "testcontainers": "^10.25.0",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  }
}
